{
  enabled: true,
  dependencyDashboard: true,
  dependencyDashboardTitle: "🤖 Renovate Dashboard",
  timezone: "Europe/Athens",
  assigneesFromCodeOwners: true,
  reviewersFromCodeOwners: true,
  assignAutomerge: true,
  gitAuthor: "stavros-k <s.kois@outlook.com>",
  baseBranches: ["master"],
  rebaseWhen: "conflicted",
  pinDigests: true,
  prConcurrentLimit: 100,
  semanticCommits: "enabled",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{newVersion}}",
  packageRules: [
    {
      enabled: true,
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["patch", "minor", "major", "digest"],
    },
    {
      enabled: true,
      matchDatasources: ["jenkins-plugins"],
      matchUpdateTypes: ["patch", "minor", "major", "pin", "digest"],
    },
    {
      enabled: true,
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["patch", "minor", "major"],
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["apache/tika"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>[a-z]+)$",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["opencloudeu/web-extensions"],
      versioning: "regex:^(?<compatibility>[a-z-]+)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      matchBaseBranches: ["master"],
      addLabels: ["master"],
    },
    {
      matchDepTypes: ["action"],
      addLabels: ["actions"],
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["patch"],
    },
  ],
  customDatasources: {
    // Splashtop publishes no release feed; its "Download Splashtop Streamer for
    // Linux" help-center article carries the current version-pinned links, and
    // the Zendesk API serves that article as JSON (the HTML page blocks bots).
    "splashtop-streamer": {
      defaultRegistryUrlTemplate: "https://support-splashtopbusiness.splashtop.com/api/v2/help_center/en-us/articles/360035513772.json",
      format: "json",
      transformTemplates: [
        '{"releases": [{"version": $match(article.body, /STB_CSRS_CentOS_v([0-9.]+)_x86_64\\.tar\\.gz/)[0].groups[0]}], "homepage": article.html_url}',
      ],
    },
  },
  customManagers: [
    {
      customType: "regex",
      fileMatch: ["Dockerfile"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sENV .*?_VERSION=(?<currentValue>.*)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      fileMatch: [".*\\.sh$"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sversion=(?<currentValue>.*)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
}
