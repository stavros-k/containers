FROM quay.io/fedora/fedora-bootc:44@sha256:aa286e6cb122f57c68db4e6d23fccc690e1b051751b3d57625bafe25766fc376

# packages.sh + the third-party repo files are bind-mounted (not copied), so
# neither lands in the final image and there's no cleanup. Mounted narrowly
# (only this step's inputs) so editing other build scripts doesn't invalidate
# this expensive layer's cache.
#
# Each extra .repo goes straight to the path dnf already reads, one mount per
# file, so packages.sh needs no reposdir override and keeps finding the base
# repos wherever the distro moves them. Mounting the whole directory would
# instead shadow /etc/yum.repos.d and hide those base repos.
RUN \
  --mount=type=bind,source=build-rootfs/scripts/packages.sh,target=/tmp/packages.sh \
  --mount=type=bind,source=build-rootfs/etc/yum.repos.d/ghostty.repo,target=/etc/yum.repos.d/ghostty.repo \
  bash /tmp/packages.sh

# programs: pinned upstream binaries/tarballs (not in any repo), one install
# script each. A single step bind-mounts the whole programs/ dir and runs every
# script, kept off the expensive package layer above. Trade-off vs a step per
# program: bumping any one re-runs them all (both are cheap). set -e so a failed
# install fails the build.
RUN \
  --mount=type=bind,source=build-rootfs/scripts/programs,target=/tmp/programs \
  set -eu; for s in /tmp/programs/*.sh; do bash "$s"; done

# # --- ssh: keys under /usr so a future image push can rotate them
# COPY root.keys /usr/etc-system/root.keys
# RUN chmod 0600 /usr/etc-system/root.keys && \
#   echo 'AuthorizedKeysFile /usr/etc-system/%u.keys' \
#   > /etc/ssh/sshd_config.d/30-auth-system.conf

# static config: copied verbatim so it persists in the image
COPY rootfs/ /

# configure.sh: user, sudoers perms, services, boot target, lint. Runs after
# COPY (touches the copied sudoers) and after packages (enables sddm). Mounted
# narrowly for the same cache reason as above.
RUN \
  --mount=type=bind,source=build-rootfs/scripts/configure.sh,target=/tmp/configure.sh \
  bash /tmp/configure.sh
