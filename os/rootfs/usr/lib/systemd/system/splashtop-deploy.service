# Register this machine's Splashtop Streamer with the team, once, unattended
# (the steps are in /usr/libexec/kiosk/splashtop-deploy).
#
# The deploy code is not in the image. The installer writes it to
# /etc/kiosk/splashtop-deploy-code (root-only, machine-local), and it's
# deleted once the machine is registered: Splashtop keeps the registration in
# its own global.conf, so the code is never needed again. A failed deploy
# keeps the file and the unit retries, so a machine that boots before the
# network is up gets through eventually.
[Unit]
Description=Register Splashtop Streamer with the team
Wants=network-online.target
After=network-online.target SRStreamer.service
ConditionPathExists=/etc/kiosk/splashtop-deploy-code

[Service]
Type=oneshot
ExecStart=/usr/libexec/kiosk/splashtop-deploy
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
